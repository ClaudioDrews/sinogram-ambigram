      "slug": "cn-centre-optimisation",
      "track": "cn",
      "kind": "construction",
      "method": "cn-centre-optimisation",
      "title": {
        "en": "Rotation centre optimisation",
        "zh": "旋转中心优化",
        "ja": "回転中心最適化"
      },
      "summary": "Optimize the 180° rotation pivot near the stroke centroid. The chosen centre may change even if no ink pixels do.",
      "formula": "c* = argmax_c |G ∩ R_c(G)|/|G|",
