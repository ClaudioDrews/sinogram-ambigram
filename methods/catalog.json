    {
      "slug": "cn-sector-deterministic",
      "track": "cn",
      "kind": "construction",
      "method": "cn-sector-deterministic",
      "title": {
        "en": "Deterministic sector thickness (R-SECT)",
        "zh": "扇区线宽确定性规则",
        "ja": "領域別線幅の決定規則"
      },
      "summary": "Compare ink mass in opposing sectors of a 3×3 partition and thicken the lighter sector up to a cap.",
      "formula": "m_sector = min(cap, ink_opposite/ink_local)",
      "example": {
        "a": "田",
        "b": "田"
      },
      "status": "Actual experimental operator output",
      "detail": "",
      "references": [
