{
  "schema": "sinogram-methods-v1",
  "revision": "2026-11-08",
  "scope": "Japanese and Chinese are equally important, experimental research tracks.",
  "methods": [
    {
      "slug": "jp-gpt-raster-iou",
      "track": "jp",
      "kind": "search",
      "method": "jp-gpt-raster-iou",
      "title": {
        "en": "GPT · raster IoU",
        "zh": "GPT · 栅格交并比",
        "ja": "GPT · ラスターIoU"
      },
      "summary": "Original raster masks were compared after a half-turn, with fixed and ±3px-aligned variants; the historic sample used font rasters, not today's KanjiVG vectors.",
      "formula": "IoU = |mask(A) ∩ R(mask(B))| / |mask(A) ∪ R(mask(B))|",
      "example": {
        "a": "甲",
        "b": "由"
      },
      "status": "Historical search/comparison",
      "detail": "The interactive source pair is a current KanjiVG illustration of the method inputs, NOT a replay of the historic run.",
      "references": [
        {
          "title": "Method evidence",
          "path": "methods/metrics-comparison.md"
        }
      ]
    },
    {
      "slug": "jp-glm-translated-iou",
      "track": "jp",
      "kind": "search",
      "method": "jp-glm-translated-iou",
      "title": {
        "en": "GLM · translated raster IoU",
        "zh": "GLM · 平移优化IoU",
        "ja": "GLM · 平行移動IoU"
      },
      "summary": "Maximises raster overlap over translation (historically ±40px), which can artificially improve a geometric candidate's rank.",
      "formula": "max_(dx,dy) IoU(A, T_(dx,dy)(R(B)))",
      "example": {
        "a": "甲",
        "b": "由"
      },
      "status": "Historical search/comparison",
      "detail": "Translating a glyph is an alignment hypothesis, not a proven reading.",
      "references": [
        {
          "title": "Method evidence",
          "path": "methods/metrics-comparison.md"
        }
      ]
    },
    {
