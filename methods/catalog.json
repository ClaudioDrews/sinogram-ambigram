    {
      "slug": "cn-sector-search",
      "track": "cn",
      "kind": "construction",
      "method": "cn-sector-search",
      "title": {
        "en": "Constrained sector thickness search",
        "zh": "扇区线宽约束搜索",
        "ja": "領域別線幅の制約探索"
      },
      "summary": "Search admissible sector multipliers under retention and growth constraints; a feasible geometric optimum is not necessarily readable.",
      "formula": "max sym(G_m) s.t. retention≥0.90, growth≤1.30",
